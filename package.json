{
  "name": "stream-access-cues",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"cargo run\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "cargo run",
    "build": "vite build",
    "build:server": "cargo build --release",
    "test": "vitest run && cargo test && npm run test:build-identity",
    "test:build-identity": "bash tests/build-identity.sh",
    "test:claims": "playwright test tests/browser/claims.spec.ts",
    "test:e2e": "playwright test && playwright test --config=playwright.hosted.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && cargo clippy --all-targets -- -D warnings"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "svelte": "^5.28.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^22.15.30",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "svelte-check": "^4.2.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
