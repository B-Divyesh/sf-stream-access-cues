{
  "name": "stream-access-cues",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"cargo run\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "cargo run",
    "build": "vite build",
    "build:server": "cargo build --release",
    "test": "vitest run && cargo test",
    "test:e2e": "playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.json && cargo clippy --all-targets -- -D warnings"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "svelte": "^5.28.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "svelte-check": "^4.2.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
